{
  "name": "offpix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "download:models": "node scripts/download-models.mjs",
    "check:pages": "node scripts/check-pages-limits.mjs",
    "make:dummy-models": "node scripts/make-dummy-models.mjs",
    "postinstall": "node scripts/copy-ort.mjs",
    "notices": "node scripts/build-notices.mjs",
    "check:notices": "node scripts/build-notices.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "comlink": "^4.4.2",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.59.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@12.14.0"
